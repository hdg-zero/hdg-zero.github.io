---
// site/src/layouts/BaseLayout.astro
// Ultra Pro Layout with Theme & i18n Support
import Header from '../components/Header.astro';
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import { translations } from '../i18n/translations';

interface Props {
	title: string;
	description?: string;
}

const { title, description = "Hippolyte de Guigné" } = Astro.props;
const base = import.meta.env.BASE_URL;

// Serialize translations for client-side script
const translationsJson = JSON.stringify(translations);
---

<!doctype html>
<html lang="fr" class="scroll-smooth overflow-x-hidden">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
		<meta name="generator" content={Astro.generator} />
		
		<!-- Google Fonts Preconnect & Stylesheet -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet" />

		<!-- Open Graph -->
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		
		<title>{title}</title>
		<ClientRouter />

		<!-- Theme & Language initialization (MUST run immediately) -->
		<script is:inline>
			// Run immediately to prevent flash
			(function() {
				const theme = localStorage.getItem('theme') || 'dark';
				document.documentElement.classList.remove('dark', 'light');
				document.documentElement.classList.add(theme);
				
				const lang = localStorage.getItem('lang') || 'fr';
				document.documentElement.setAttribute('data-lang', lang);
				document.documentElement.lang = lang;
			})();
			
			// Also run on Astro view transitions
			document.addEventListener('astro:before-swap', (event) => {
				const theme = localStorage.getItem('theme') || 'dark';
				event.newDocument.documentElement.classList.remove('dark', 'light');
				event.newDocument.documentElement.classList.add(theme);
				
				const lang = localStorage.getItem('lang') || 'fr';
				event.newDocument.documentElement.setAttribute('data-lang', lang);
				event.newDocument.documentElement.lang = lang;
			});
		</script>
	</head>
	
	<!-- 
      FIX MOBILE: 
      - overflow-x-hidden : Empêche le scroll horizontal indésirable
      - w-full : Force la largeur à 100% du viewport
      - relative : Crée un contexte de positionnement pour les éléments absolus internes
    -->
	<body class="min-h-screen flex flex-col font-display antialiased overflow-x-hidden w-full relative bg-[var(--bg-primary)] text-[var(--text-primary)]">
		<!-- Interactive Neural Network / Agent Topology Background Canvas -->
		<canvas id="neural-bg" class="fixed inset-0 pointer-events-none z-0 w-full h-full opacity-0 transition-opacity duration-1000" aria-hidden="true"></canvas>

		<Header />
		
		<main class="flex-1 w-full relative">
			<slot />
		</main>
		
		<!-- Minimal Footer -->
		<footer class="relative border-t border-[var(--glass-border)] mt-20 w-full">
			<!-- Ambient glow (Maintenu par overflow-hidden du body) -->
			<div class="absolute top-0 left-1/2 -translate-x-1/2 w-[600px] h-[1px] bg-gradient-to-r from-transparent via-[var(--accent-primary)] to-transparent opacity-50"></div>
			
			<div class="container mx-auto px-4 sm:px-6 py-8 sm:py-12">
				<div class="flex flex-col md:flex-row justify-between items-center gap-6">
					
					<!-- Brand -->
					<a href={base} class="inline-flex items-center gap-3 group">
						<div class="w-8 h-8 rounded-xl bg-gradient-to-br from-[var(--accent-primary)] to-[var(--accent-secondary)] flex items-center justify-center font-bold text-white text-sm group-hover:scale-110 transition-transform">
							H
						</div>
						<span class="font-semibold text-[var(--text-primary)]">Hippolyte de Guigné</span>
					</a>

					<!-- Social Links -->
					<div class="flex items-center gap-4">
						<a href="https://github.com/hdg-zero" target="_blank" rel="noopener" 
						   class="text-[var(--text-muted)] hover:text-[var(--accent-primary)] transition-colors">
							<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
								<path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
							</svg>
						</a>
						<a href="https://fr.linkedin.com/in/hippolyte-de-guigné" target="_blank" rel="noopener" 
						   class="text-[var(--text-muted)] hover:text-[var(--accent-primary)] transition-colors">
							<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
								<path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
							</svg>
						</a>
						<a href="mailto:hdg-zero@pm.me" 
						   class="text-[var(--text-muted)] hover:text-[var(--accent-primary)] transition-colors">
							<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
							</svg>
						</a>
					</div>
				</div>
			</div>
		</footer>

		<script is:inline define:vars={{ translationsJson }}>
			// Store translations in window for access across scripts
			window.__translations = window.__translations || JSON.parse(translationsJson);
		</script>

		<script>
			// Get translations from window
			function getTranslations() {
				return window.__translations || { fr: {}, en: {} };
			}
			
			// Get current language
			function getLang() {
				return localStorage.getItem('lang') || 'fr';
			}
			
			// Get translation
			function t(path) {
				const lang = getLang();
				const translations = getTranslations();
				const keys = path.split('.');
				let value = translations[lang];
				for (const key of keys) {
					value = value?.[key];
				}
				return value || path;
			}
			
			// Mapping of legacy/shorthand data attributes to translation keys
			const attrMap: Record<string, string> = {
				'data-nav-home': 'nav.home',
				'data-nav-work': 'nav.work',
				'data-nav-blog': 'nav.blog',
				'data-nav-contact': 'nav.contact',
				'data-hero-role-badge': 'hero.roleBadge',
				'data-hero-headline': 'hero.headline',
				'data-hero-headline-accent': 'hero.headlineAccent',
				'data-hero-subtitle': 'hero.subtitle',
				'data-hero-view-work': 'hero.viewWork',
				'data-hero-read-blog': 'hero.readBlog',
				'data-work-label': 'work.sectionLabel',
				'data-work-title': 'work.title',
				'data-work-title-accent': 'work.titleAccent',
				'data-work-description': 'work.description',
				'data-work-latest': 'work.latest',
				'data-work-view-all': 'work.viewAll',
				'data-work-view-details': 'work.viewDetails',
				'data-blog-label': 'blog.sectionLabel',
				'data-blog-title': 'blog.title',
				'data-blog-title-accent': 'blog.titleAccent',
				'data-blog-description': 'blog.description',
				'data-blog-read-article': 'blog.readArticle',
				'data-blog-engineering': 'blog.engineeringBlog',
				'data-blog-blog-desc': 'blog.blogDesc',
				'data-blog-read-articles': 'blog.readArticles',
				'data-blog-subscribe': 'blog.subscribe',
				'data-blog-stay-updated': 'blog.stayUpdated',
				'data-projects-label': 'projects.sectionLabel',
				'data-projects-title': 'projects.title',
				'data-projects-title-accent': 'projects.titleAccent',
				'data-projects-description': 'projects.description',
				'data-projects-all': 'projects.all',
				'data-projects-view-details': 'projects.viewDetails',
				'data-projects-no-projects': 'projects.noProjects',
				'data-projects-coming-soon': 'projects.comingSoon',
			};

			// Apply translations to all translatable elements
			function applyTranslations() {
				// 1. Standard data-i18n attributes
				document.querySelectorAll('[data-i18n]').forEach(el => {
					const key = el.getAttribute('data-i18n');
					if (key) {
						const translation = t(key);
						if (translation && translation !== key) {
							el.textContent = translation;
						}
					}
				});

				// 2. data-i18n-title attributes (tooltips/attributes)
				document.querySelectorAll('[data-i18n-title]').forEach(el => {
					const key = el.getAttribute('data-i18n-title');
					if (key) {
						const translation = t(key);
						if (translation) el.setAttribute('title', translation);
					}
				});

				// 3. Shorthand data attributes
				for (const [attr, key] of Object.entries(attrMap)) {
					const translation = t(key);
					if (translation) {
						document.querySelectorAll(`[${attr}]`).forEach(el => {
							el.textContent = translation;
						});
					}
				}

				// 4. Toggle language-specific sections
				const currentLang = getLang();
				document.querySelectorAll('[data-lang-section]').forEach(el => {
					const sLang = el.getAttribute('data-lang-section');
					(el as HTMLElement).style.display = (sLang === currentLang) ? '' : 'none';
				});
			}
			
			// Initialize on page load
			document.addEventListener('astro:page-load', () => {
				const main = document.querySelector('main');
				if (main) {
					main.style.opacity = '0';
					main.style.transform = 'translateY(20px)';
					requestAnimationFrame(() => {
						main.style.transition = 'opacity 0.6s cubic-bezier(0.22, 1, 0.36, 1), transform 0.6s cubic-bezier(0.22, 1, 0.36, 1)';
						main.style.opacity = '1';
						main.style.transform = 'translateY(0)';
					});
				}

				// Mouse tracking for glass cards
				const cards = document.querySelectorAll('.bento-card, .glass-card');
				cards.forEach(card => {
					card.addEventListener('mousemove', (e) => {
						const rect = card.getBoundingClientRect();
						const x = ((e.clientX - rect.left) / rect.width) * 100;
						const y = ((e.clientY - rect.top) / rect.height) * 100;
						(card as HTMLElement).style.setProperty('--mouse-x', `${x}%`);
						(card as HTMLElement).style.setProperty('--mouse-y', `${y}%`);
					});
				});

				// Ecouteur d'événement pour le changement de langue déclenché par le Header
				// Le Header gère le clic, nous mettons simplement à jour le contenu
				window.addEventListener('languageChange', () => {
					applyTranslations();
				});
				
				// Interactive Neural Network / Agent Topology Background Canvas Simulation
				const canvas = document.getElementById('neural-bg') as HTMLCanvasElement | null;
				if (canvas && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
					const ctx = canvas.getContext('2d', { alpha: true });
					if (ctx) {
						let width = window.innerWidth;
						let height = window.innerHeight;
						let dpr = Math.min(window.devicePixelRatio || 1, 2);
						let rafId = 0;
						let isLight = document.documentElement.classList.contains('light');

						// Watch for light/dark theme toggles
						const themeObserver = new MutationObserver(() => {
							isLight = document.documentElement.classList.contains('light');
						});
						themeObserver.observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });

						interface NetworkNode {
							x: number;
							y: number;
							vx: number;
							vy: number;
							radius: number;
							pulse: number;
							pulseSpeed: number;
						}

						interface Packet {
							fromIndex: number;
							toIndex: number;
							progress: number;
							speed: number;
						}

						interface Shockwave {
							x: number;
							y: number;
							radius: number;
							maxRadius: number;
							alpha: number;
						}

						const nodes: NetworkNode[] = [];
						const packets: Packet[] = [];
						const shockwaves: Shockwave[] = [];
						const maxConnectionDist = 135;
						const mouseRadius = 185;

						let mouseX = -9999;
						let mouseY = -9999;
						let isMouseActive = false;

						const setupNodes = () => {
							nodes.length = 0;
							packets.length = 0;
							const nodeCount = Math.max(34, Math.min(75, Math.floor((width * height) / 21000)));
							for (let i = 0; i < nodeCount; i++) {
								nodes.push({
									x: Math.random() * width,
									y: Math.random() * height,
									vx: (Math.random() - 0.5) * 0.45,
									vy: (Math.random() - 0.5) * 0.45,
									radius: 1.2 + Math.random() * 1.6,
									pulse: Math.random() * Math.PI * 2,
									pulseSpeed: 0.02 + Math.random() * 0.03
								});
							}

							const packetCount = Math.min(18, Math.max(8, Math.floor(nodeCount / 3)));
							for (let k = 0; k < packetCount; k++) {
								const from = Math.floor(Math.random() * nodeCount);
								let to = (from + 1 + Math.floor(Math.random() * (nodeCount - 1))) % nodeCount;
								packets.push({
									fromIndex: from,
									toIndex: to,
									progress: Math.random(),
									speed: 0.007 + Math.random() * 0.012
								});
							}
						};

						const resize = () => {
							width = window.innerWidth;
							height = window.innerHeight;
							dpr = Math.min(window.devicePixelRatio || 1, 2);
							canvas.width = Math.floor(width * dpr);
							canvas.height = Math.floor(height * dpr);
							ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
							setupNodes();
						};

						resize();
						let resizeTimeout: number | undefined;
						const onResize = () => {
							clearTimeout(resizeTimeout);
							resizeTimeout = window.setTimeout(resize, 150);
						};
						window.addEventListener('resize', onResize, { passive: true });

						// Mouse & interaction events
						const onPointerMove = (e: PointerEvent) => {
							mouseX = e.clientX;
							mouseY = e.clientY;
							isMouseActive = true;
						};

						const onPointerLeave = () => {
							isMouseActive = false;
							mouseX = -9999;
							mouseY = -9999;
						};

						const onPointerDown = (e: PointerEvent) => {
							if (shockwaves.length < 5) {
								shockwaves.push({
									x: e.clientX,
									y: e.clientY,
									radius: 2,
									maxRadius: 260,
									alpha: 0.65
								});
							}
						};

						window.addEventListener('pointermove', onPointerMove, { passive: true });
						document.addEventListener('pointerleave', onPointerLeave);
						window.addEventListener('pointerdown', onPointerDown, { passive: true });

						// Reveal canvas
						requestAnimationFrame(() => {
							canvas.style.opacity = '1';
						});

						// Adjacency for packet routing
						const neighborsMap = new Map<number, number[]>();

						// Animation Frame
						const render = () => {
							ctx.clearRect(0, 0, width, height);

							// Palette definitions according to current theme
							const primaryRgb = isLight ? '13, 148, 136' : '94, 234, 212';
							const coreRgb = isLight ? '15, 23, 42' : '240, 253, 250';
							const packetRgb = isLight ? '15, 118, 110' : '255, 255, 255';
							const synapseBaseAlpha = isLight ? 0.20 : 0.26;

							neighborsMap.clear();
							for (let i = 0; i < nodes.length; i++) {
								neighborsMap.set(i, []);
							}

							// 1. Update Nodes (movement + wake repulsion + click shockwaves + boundaries)
							for (let i = 0; i < nodes.length; i++) {
								const n = nodes[i];

								// Fluid Repulsion Wake from Mouse
								if (isMouseActive) {
									const dx = n.x - mouseX;
									const dy = n.y - mouseY;
									const dist = Math.hypot(dx, dy);
									if (dist < mouseRadius && dist > 0.1) {
										const force = (1 - dist / mouseRadius) * 0.75;
										n.vx += (dx / dist) * force;
										n.vy += (dy / dist) * force;
									}
								}

								// Shockwaves radial impulse
								for (let s = 0; s < shockwaves.length; s++) {
									const wave = shockwaves[s];
									const dx = n.x - wave.x;
									const dy = n.y - wave.y;
									const dist = Math.hypot(dx, dy);
									if (Math.abs(dist - wave.radius) < 26 && dist > 0.1) {
										const push = 1.3 * (1 - wave.radius / wave.maxRadius);
										n.vx += (dx / dist) * push;
										n.vy += (dy / dist) * push;
									}
								}

								// Subtle brownian organic drift + speed damping
								n.vx += (Math.random() - 0.5) * 0.025;
								n.vy += (Math.random() - 0.5) * 0.025;
								const speed = Math.hypot(n.vx, n.vy);
								if (speed > 2.6) {
									n.vx = (n.vx / speed) * 2.6;
									n.vy = (n.vy / speed) * 2.6;
								}
								n.vx *= 0.985;
								n.vy *= 0.985;

								n.x += n.vx;
								n.y += n.vy;

								// Smooth bounce/wrap inside margins
								const pad = 15;
								if (n.x < -pad) { n.x = width + pad; }
								else if (n.x > width + pad) { n.x = -pad; }
								if (n.y < -pad) { n.y = height + pad; }
								else if (n.y > height + pad) { n.y = -pad; }

								// Pulse animation
								n.pulse += n.pulseSpeed;
							}

							// 2. Render Shockwaves
							for (let s = shockwaves.length - 1; s >= 0; s--) {
								const wave = shockwaves[s];
								wave.radius += 6;
								wave.alpha = Math.max(0, 0.65 * (1 - wave.radius / wave.maxRadius));
								if (wave.radius >= wave.maxRadius || wave.alpha <= 0.01) {
									shockwaves.splice(s, 1);
									continue;
								}
								ctx.beginPath();
								ctx.arc(wave.x, wave.y, wave.radius, 0, Math.PI * 2);
								ctx.strokeStyle = `rgba(${primaryRgb}, ${wave.alpha * 0.55})`;
								ctx.lineWidth = 1.5;
								ctx.stroke();
							}

							// 3. Render Synaptic Connections (Network)
							ctx.lineWidth = 0.9;
							for (let i = 0; i < nodes.length; i++) {
								const na = nodes[i];
								for (let j = i + 1; j < nodes.length; j++) {
									const nb = nodes[j];
									const dx = nb.x - na.x;
									const dy = nb.y - na.y;
									const dist = Math.hypot(dx, dy);

									if (dist < maxConnectionDist) {
										neighborsMap.get(i)?.push(j);
										neighborsMap.get(j)?.push(i);

										const alpha = (1 - dist / maxConnectionDist) * synapseBaseAlpha;
										ctx.strokeStyle = `rgba(${primaryRgb}, ${alpha})`;
										ctx.beginPath();
										ctx.moveTo(na.x, na.y);
										ctx.lineTo(nb.x, nb.y);
										ctx.stroke();
									}
								}

								// Connect nodes to mouse with laser arcs
								if (isMouseActive) {
									const mdx = na.x - mouseX;
									const mdy = na.y - mouseY;
									const mDist = Math.hypot(mdx, mdy);
									if (mDist < mouseRadius) {
										const mAlpha = (1 - mDist / mouseRadius) * (isLight ? 0.45 : 0.6);
										ctx.strokeStyle = `rgba(${primaryRgb}, ${mAlpha})`;
										ctx.lineWidth = 1.2;
										ctx.beginPath();
										ctx.moveTo(mouseX, mouseY);
										ctx.lineTo(na.x, na.y);
										ctx.stroke();
										ctx.lineWidth = 0.9;
									}
								}
							}

							// 4. Render Data Packets ("Pipes")
							for (let p = 0; p < packets.length; p++) {
								const pkt = packets[p];
								pkt.progress += pkt.speed;

								const fromNode = nodes[pkt.fromIndex];
								const toNode = nodes[pkt.toIndex];

								if (!fromNode || !toNode || pkt.progress >= 1) {
									// Pick next hop from connected neighbors or new node
									const neighbors = neighborsMap.get(pkt.toIndex) || [];
									pkt.fromIndex = pkt.toIndex;
									if (neighbors.length > 0) {
										pkt.toIndex = neighbors[Math.floor(Math.random() * neighbors.length)];
									} else {
										pkt.fromIndex = Math.floor(Math.random() * nodes.length);
										pkt.toIndex = Math.floor(Math.random() * nodes.length);
									}
									pkt.progress = 0;
									pkt.speed = 0.008 + Math.random() * 0.014;
									continue;
								}

								// Check if line is still within proximity
								const pDist = Math.hypot(toNode.x - fromNode.x, toNode.y - fromNode.y);
								if (pDist > maxConnectionDist * 1.2) {
									pkt.progress = 1; // force re-route next frame
									continue;
								}

								const px = fromNode.x + (toNode.x - fromNode.x) * pkt.progress;
								const py = fromNode.y + (toNode.y - fromNode.y) * pkt.progress;

								// Draw packet pulse
								ctx.beginPath();
								ctx.arc(px, py, 2.2, 0, Math.PI * 2);
								ctx.fillStyle = `rgba(${packetRgb}, 0.95)`;
								ctx.shadowColor = `rgba(${primaryRgb}, 0.8)`;
								ctx.shadowBlur = 6;
								ctx.fill();
								ctx.shadowBlur = 0;
							}

							// 5. Render Autonomous Nodes ("Fourmis / Agents")
							for (let i = 0; i < nodes.length; i++) {
								const n = nodes[i];
								const pulseFactor = 0.65 + 0.35 * Math.sin(n.pulse);
								const r = n.radius * (1 + 0.15 * Math.sin(n.pulse));

								// Outer glow / halo
								ctx.beginPath();
								ctx.arc(n.x, n.y, r * 2, 0, Math.PI * 2);
								ctx.fillStyle = `rgba(${primaryRgb}, ${pulseFactor * (isLight ? 0.12 : 0.18)})`;
								ctx.fill();

								// Core body
								ctx.beginPath();
								ctx.arc(n.x, n.y, r, 0, Math.PI * 2);
								ctx.fillStyle = `rgba(${primaryRgb}, ${pulseFactor * 0.75})`;
								ctx.fill();

								// High-precision center spark
								ctx.beginPath();
								ctx.arc(n.x, n.y, Math.max(0.6, r * 0.45), 0, Math.PI * 2);
								ctx.fillStyle = `rgba(${coreRgb}, 0.85)`;
								ctx.fill();
							}

							rafId = requestAnimationFrame(render);
						};

						rafId = requestAnimationFrame(render);

						document.addEventListener('astro:before-swap', () => {
							cancelAnimationFrame(rafId);
							window.removeEventListener('resize', onResize);
							window.removeEventListener('pointermove', onPointerMove);
							document.removeEventListener('pointerleave', onPointerLeave);
							window.removeEventListener('pointerdown', onPointerDown);
							themeObserver.disconnect();
						}, { once: true });
					}
				}

				// Apply translations on load
				applyTranslations();
			});
		</script>
	</body>
</html>